{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "npm run start -- --hostname 127.0.0.1 --port 3001",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 120000,
      "url": [
        "http://127.0.0.1:3001/",
        "http://127.0.0.1:3001/work/velo",
        "http://127.0.0.1:3001/work/portfolio-platform"
      ],
      "settings": {
        "preset": "perf",
        "onlyCategories": ["performance", "seo"],
        "chromeFlags": "--headless --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:seo": [
          "error",
          { "minScore": 0.95, "aggregationMethod": "median-run" }
        ],
        "categories:performance": [
          "error",
          { "minScore": 0.9, "aggregationMethod": "median-run" }
        ],
        "largest-contentful-paint": [
          "error",
          { "maxNumericValue": 2500, "aggregationMethod": "median-run" }
        ],
        "cumulative-layout-shift": [
          "error",
          { "maxNumericValue": 0.05, "aggregationMethod": "median-run" }
        ],
        "total-blocking-time": [
          "error",
          { "maxNumericValue": 200, "aggregationMethod": "median-run" }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "test-artifacts/lighthouse"
    }
  }
}
